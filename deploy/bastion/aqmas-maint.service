# Root maintenance runner behind Settings → Setup (docs/SETUP.md). It runs only tasks compiled
# into aqmasd, each one requested by a passkey-signed approval that it verifies itself against
# /etc/aqmas/update-passkeys.json. Installed by `aqmasd maint-init`.
[Unit]
Description=aqmas maintenance runner (owner-approved setup tasks and upgrades)
After=network-online.target
Wants=network-online.target
# A failed or refused task still exits 0 (it is reported on the Setup page). Only an
# interrupted task that cannot be finished exits non-zero; the runner paces those retries
# itself and gives up after a few. The limit below only stops a runaway loop.
StartLimitIntervalSec=120
StartLimitBurst=20

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/bin/aqmasd maint-run
# A task may wait for the owner (cutover, sealing) or rebuild a release.
TimeoutStartSec=2h
PrivateTmp=yes
ProtectHome=yes
PrivateDevices=yes
TasksMax=512
MemoryMax=4G
