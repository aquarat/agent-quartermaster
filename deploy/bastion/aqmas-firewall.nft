#!/usr/sbin/nft -f
# aqmas agent API (:8443): LAN (192.0.2.0/24) only. Its own table, like other_filter;
# replaced atomically by aqmas-firewall.service. The web UI listens on 127.0.0.1:8080 only.
table inet aqmas_agent_api
delete table inet aqmas_agent_api
table inet aqmas_agent_api {
	chain input {
		type filter hook input priority filter - 10; policy accept;
		tcp dport 8443 ip saddr 192.0.2.0/24 accept
		tcp dport 8443 counter drop
	}
}
