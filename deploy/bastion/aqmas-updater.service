[Unit]
Description=Verify owner signature, rebuild and install aqmas release
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
User=root
UMask=0077
StateDirectory=aqmas-updater
StateDirectoryMode=0700
EnvironmentFile=/etc/aqmas/updater.env
ExecStart=/usr/local/libexec/aqmas-updater.sh
TimeoutStartSec=45min
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ReadWritePaths=/usr/local/bin /var/lib/aqmas-releases /var/spool/aqmas-update
TasksMax=512
MemoryMax=4G
