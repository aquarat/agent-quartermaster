# agent-quartermaster server on the bastion host.
# Install: see install.sh (prints the steps; --apply runs them locally on the bastion).
[Unit]
Description=agent-quartermaster credential broker (aqmasd)
Documentation=https://github.com/aquarat/agent-quartermaster
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aqmas
Group=aqmas
ExecStart=/usr/local/bin/aqmasd -config /etc/aqmas/config.toml serve
Restart=on-failure
RestartSec=5

# /var/lib/aqmas (database + CA keys + Cloudflare snapshots in /var/lib/aqmas/cf-snapshots) and
# /etc/aqmas (config, root:aqmas 0640). StateDirectory= is writable despite ProtectSystem=strict;
# a cloudflare.snapshot_dir outside /var/lib/aqmas would also need ReadWritePaths=.
StateDirectory=aqmas
StateDirectoryMode=0700
RuntimeDirectory=aqmas-lock
RuntimeDirectoryMode=0755
ConfigurationDirectory=aqmas
ConfigurationDirectoryMode=0750
UMask=0077

# Cloudflare parent tokens (milestone 2, docs/CLOUDFLARE.md section 6): root:root 0600 files in
# /etc/aqmas, handed over by systemd and read once at start from $CREDENTIALS_DIRECTORY (never
# logged, never in the database). Enable them in a drop-in so reinstalling this unit keeps them:
#   /etc/systemd/system/aqmasd.service.d/cloudflare.conf:
#     [Service]
#     LoadCredential=cf-proxy-token:/etc/aqmas/cf-proxy-token
#     LoadCredential=cf-minter-token:/etc/aqmas/cf-minter-token
#LoadCredential=cf-proxy-token:/etc/aqmas/cf-proxy-token
#LoadCredential=cf-minter-token:/etc/aqmas/cf-minter-token

# Hardening. Outbound HTTPS (ntfy; api.cloudflare.com when [cloudflare] is enabled) needs
# AF_INET/AF_INET6 and DNS: do not add IPAddressDeny= or drop those address families.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=-/var/spool/aqmas-update
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# These two calls on dedicated pages do not require IPC_LOCK within the
# unit's memlock limit. Keep the rest of @privileged denied.
SystemCallFilter=mlock munlock
SystemCallErrorNumber=EPERM
LimitNOFILE=4096
LimitCORE=0
LimitMEMLOCK=2M
TasksMax=256

[Install]
WantedBy=multi-user.target
