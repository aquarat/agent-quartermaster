# agent-quartermaster server on the bastion (192.0.2.60).
# Install: see install.sh (prints the steps; --apply runs them locally on the bastion).
[Unit]
Description=agent-quartermaster credential broker (aqmasd)
Documentation=https://github.com/aquarat/agent-quartermaster
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aqmas
Group=aqmas
ExecStart=/usr/local/bin/aqmasd -config /etc/aqmas/config.toml serve
Restart=on-failure
RestartSec=5

# /var/lib/aqmas (database + CA keys) and /etc/aqmas (config, root:aqmas 0640).
StateDirectory=aqmas
StateDirectoryMode=0700
ConfigurationDirectory=aqmas
ConfigurationDirectoryMode=0750
UMask=0077

# Hardening.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
LimitNOFILE=4096
TasksMax=256

[Install]
WantedBy=multi-user.target
